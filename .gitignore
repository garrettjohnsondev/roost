node_modules/
dist/
.DS_Store
*.log
.env
.roost-state.json
.roost-data/

# Pre-rename paths. Kept ignored so a migration leftover on any machine can
# never be committed: renaming these in .gitignore un-ignored 40 MB of usage
# data on the very commit that did the rename.
.pocket-state.json
.pocket-data/
.pocket/plans/

# 1024px originals from the avatar generator now live in .roost-data/avatar-raw; only the 128px versions ship.
web/public/avatars/raw-*.png

# Per-task plan files written by build/plan mode; working artifacts, not source.
.roost/plans/

# Vendored third-party skills installed by `npx skills add`. The LOCKFILE is
# committed so the install is reproducible; the copied skill text is not ours.
.agents/skills/
.claude/skills/

# 1024px sprite originals live in .roost-data/sprite-raw; only the 256px webp
# frames under web/public/crew/ ship. 10.4 MB of PNG becomes 580 KB.
.claude/

# Your own settings: projects, plan, routes (made on first run).
roost.config.json
